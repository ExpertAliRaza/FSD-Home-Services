VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Supabase Edge Function secrets (set in Supabase dashboard -> Edge Functions -> chat -> Secrets,
# or via supabase secrets set). The chat function is an internal admin AI assistant.
# GROQ_API_KEY is required for the Groq LLM call.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase.
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL (optional): Groq model id used by the admin AI chat function.
# Defaults to openai/gpt-oss-120b in code. llama-3.3-70b-versatile is no longer
# available to developer-plan keys (Enterprise-only), so only set this to a model
# your key can actually access, e.g. openai/gpt-oss-120b or openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-120b
